# Configuration ESP-IDF 4.4 pour l'ODROID-GO (env odroid-go-idf), reprise de retro-go.
#
# Le point essentiel : le lanceur d'origine ecrit une table de partitions sans somme MD5.
# Avec CONFIG_PARTITION_TABLE_MD5=y (valeur par defaut, et celle de la bibliotheque Arduino
# precompilee), l'application plante au demarrage dans esp_ota_get_running_partition.
CONFIG_PARTITION_TABLE_MD5=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# L'ODROID-GO a 16 Mo de flash (la partition « nvs » du .fw est a 0x400000)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT=n
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
